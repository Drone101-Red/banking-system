# ── PostgreSQL ─────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=banking
POSTGRES_USER=banking_user
POSTGRES_PASSWORD=secret123

# ── TigerBeetle ────────────────────────────────────
TB_ADDRESS=tigerbeetle:3000
TB_CLUSTER_ID=0
BANK_ACCOUNT_ID=1
TB_LEDGER_USD=1
TB_CODE_SAVINGS=100
TB_CODE_BANK=200

# ── JWT ────────────────────────────────────────────
JWT_SECRET=change_me_before_production_min_32_chars
JWT_EXPIRY_HOURS=24

# ── OpenRouter ─────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ── App ────────────────────────────────────────────
APP_PORT=8080
APP_ENV=development
TEST_DATA_LIMIT=100
